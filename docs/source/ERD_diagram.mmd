---
title: ERD
config:
    theme: 'base'
    themeVariables:
        primaryColor: '#ceb888'
        primaryTextColor: '#101820'
        primaryBorderColor: #ffc72c
        lineColor: '#101820'
---

erDiagram
    CUSTOMER ||--o{ ORDER : places
    ORDER ||--|{ ORDER_ITEM : contains
    PRODUCT ||--o{ ORDER_ITEM : includes
    CUSTOMER {
        string id
        string name
        string email
    }
    ORDER {
        string id
        date orderDate
        string status
    }
    PRODUCT {
        string id
        string name
        float price
    }
    ORDER_ITEM {
        int quantity
        float price
    }
